<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>TapDR.Dovetail.Mastercam2027</AssemblyName>
    <RootNamespace>TapDR.Dovetail.Mastercam2027</RootNamespace>
    <MastercamInstallDir Condition="'$(MastercamInstallDir)' == ''">C:\Program Files\Mastercam 2027</MastercamInstallDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TapDR.Dovetail.Core\TapDR.Dovetail.Core.csproj" />
    <Reference Include="NETHook3_0">
      <HintPath>$(MastercamInstallDir)\NETHook3_0.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
